# Gabarit du Secret K8s — copier en secrets.yaml (gitignoré) et remplir les
# vraies valeurs avant tout déploiement. Ne jamais committer secrets.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: ds-covid-secrets
  namespace: ds-covid
type: Opaque
stringData:
  API_KEY: ""                    # Définir en prod
  MINIO_ROOT_USER: "minioadmin"
  MINIO_ROOT_PASSWORD: ""        # Définir en prod
  POSTGRES_USER: "mlflow"
  POSTGRES_PASSWORD: ""          # Définir en prod
  POSTGRES_DB: "mlflow"
