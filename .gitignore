# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
backend/.venv/
data-service/.venv/
*.egg-info/

# Logs locaux (contenu ignoré, dossiers trackés via .gitkeep)
tmp/logs/
tmp/quality/
!tmp/logs/.gitkeep
!tmp/quality/.gitkeep
*.pid

# Env
.env
.venv
data/
__pycache__/
*.pyc

# Secrets K8s réels (le gabarit secrets.yaml.example reste tracké)
kubernetes/secrets.yaml

# Data & modèles (versionnés via DVC en Phase 2)
data/raw/
data/processed/
data/models/*.keras
data/models/*.h5
data/models/*.pkl

# DVC
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# MLflow (tracking géré par le serveur Docker Postgres+MinIO, pas par git)
mlruns/
mlartifacts/
mlflow.db
.trash/

# Notebooks
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Coverage
.coverage
htmlcov/
coverage.xml
*-coverage.xml

# Zip temporaires
_zip_extracted/
*.zip

# Dossiers générés localement (racine uniquement)
/models/
# /outputs/* (pas /outputs/) : un pattern sur le dossier lui-même empêcherait toute
# ré-inclusion d'un sous-dossier ensuite (limitation git — on ne peut pas ré-inclure un
# chemin dont le parent est exclu). outputs/drift/ est ré-inclus ci-dessous : rapport de
# dérive Evidently versionné via DVC (pointeur .dvc trackable par git, contenu réel
# récupéré via `dvc pull` — évite de committer 3 Mo de HTML dans git). Le contenu réel
# (report.html) reste ignoré via le .gitignore local que DVC génère dans outputs/drift/.
/outputs/*
!/outputs/drift/
/tmp/

# Claude Code (mémoire IA + config locale non partagée)
.claude/*
!.claude/rules/
!.claude/skills/
!.claude/agents/
!.claude/CLAUDE_AUDIT.md

# Fichiers de travail locaux
plan_de_base.txt
*.docx
infrastructure/kubernetes/secrets.yaml
